module instr_mem(

    input wire [31:0] addr,

    output wire [31:0] instruction

);

reg [31:0] mem [0:255]; // memory is 31 bit and has 255 addresses

integer i;

initial begin

    // Initialize entire memory with NOPs
    for (i = 0; i < 256; i = i + 1)
        mem[i] = 32'h00000013;   // NOP (addi x0, x0, 0)

    // Program
    mem[0] = 32'h00500093; // addi x1,x0,5
    mem[1] = 32'h00A00113; // addi x2,x0,10
    mem[2] = 32'h002081B3; // add x3,x1,x2
    mem[3] = 32'h00302023; // sw x3,0(x0)
    mem[4] = 32'h00002203; // lw x4,0(x0)
    mem[5] = 32'h00320463; // beq x4,x3,8
    mem[6] = 32'h06300293; // addi x5,x0,99
    mem[7] = 32'h04D00313; // addi x6,x0,77

end
assign instruction = mem[addr[31:2]]; // instruction at the memory address (from pc)
//addr from pc; pc = 0,4,8,12 etc; therefore 
//divided by 4 (shift right by 2 bits to get memory index)

endmodule

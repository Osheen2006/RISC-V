module alu (
    input wire [31:0] a,
    input wire [31:0] b,
    input wire [3:0] alu_control,
    output reg [31:0] result,
    output wire zero
);

always @(*) begin
    case (alu_control)
        4'b0010: result = a + b;  // ADD
        4'b0110: result = a - b;  // SUB
        default: result = 32'b0;
    endcase
end

assign zero = (result == 32'b0);

endmodule

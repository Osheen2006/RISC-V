module imm_gen (
    input wire [31:0] instruction,
    output reg [31:0] imm_out
);

wire [6:0] opcode;
assign opcode = instruction[6:0];

always @(*) begin
    case (opcode)

        7'b0010011: begin
            // I-type: addi
            imm_out = {{20{instruction[31]}}, instruction[31:20]};
        end

        7'b0000011: begin
            // I-type: lw
            imm_out = {{20{instruction[31]}}, instruction[31:20]};
        end

        7'b0100011: begin
            // S-type: sw
            imm_out = {{20{instruction[31]}}, instruction[31:25], instruction[11:7]};
        end

        7'b1100011: begin
            // B-type: beq
            imm_out = {{19{instruction[31]}},
                       instruction[31],
                       instruction[7],
                       instruction[30:25],
                       instruction[11:8],
                       1'b0};
        end

        default: begin
            imm_out = 32'b0;
        end

    endcase
end

endmodule
